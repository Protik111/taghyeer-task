# REST API base — note the required /api prefix (the API's own Postman
# collection variable omits it; verified live that requests 404 without it).
NEXT_PUBLIC_API_BASE_URL=https://frontend-task-chatapp.onrender.com/api

# Socket.IO connects at the server ROOT origin, not under /api (verified via
# a raw Engine.IO handshake against /socket.io/).
NEXT_PUBLIC_SOCKET_URL=https://frontend-task-chatapp.onrender.com
